            ]
          }
        ]
      },
      {
        "id": "RiskAssessment.extension:confidence",
        "path": "RiskAssessment.extension",
        "sliceName": "confidence",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "https://tributary.health/fhir/StructureDefinition/assessment-confidence"
            ]
          }
        ]
      },
      {
        "id": "RiskAssessment.extension:factor",
        "path": "RiskAssessment.extension",
        "sliceName": "factor",
        "min": 0,
